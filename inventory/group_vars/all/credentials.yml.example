---
# Plain-text controller credentials (no Ansible Vault).
# 1. Copy this file to credentials.yml in the same folder:
#      cp inventory/group_vars/all/credentials.yml.example inventory/group_vars/all/credentials.yml
# 2. Fill in the real values and restrict access:  chmod 600 inventory/group_vars/all/credentials.yml
# credentials.yml is git-ignored. Never commit it, and use a read-only controller account.
mc_user: admin
mc_password: change-me
mc_enable_password: change-me
